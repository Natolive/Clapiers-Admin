# NUXT_PUBLIC_* are PUBLIC by design (bundled into the browser JS), so there is
# nothing secret here. Real per-env values are set at build time / injected by
# the platform. Any (rare) secret would go in frontend/.env.local (gitignored).
# ============================================================================

NUXT_PUBLIC_API_BASE=https://api.clapiers.local/api

