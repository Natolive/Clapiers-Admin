# Frontend (Nuxt) environment — template.
# Copy to `frontend/.env` and fill in real values. `frontend/.env` is gitignored.
# Read at runtime via useRuntimeConfig()/process.env (see nuxt.config.ts).

NUXT_PUBLIC_API_BASE=https://api.clapiers.local/api

# Google reCAPTCHA v2 site key — leave empty to disable the widget.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
