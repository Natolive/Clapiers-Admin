# ============================================================================
# Backend (Symfony) environment — COMMITTED defaults.
# ----------------------------------------------------------------------------
# Safe, non-secret defaults loaded by Symfony's Dotenv at every boot (incl.
# cache:clear during the image build). Real values override these:
#   - locally: backend/.env.local (gitignored)
#   - preprod/prod: environment variables injected by k8s
# Never put secrets here.
# ============================================================================

APP_ENV=dev
APP_SECRET=change_me

# In Docker the DB host is the `postgres` service. CI / native runs override
# DATABASE_URL via a real env var.
DATABASE_URL=postgresql://symfony:symfony@postgres:5432/clapiers_db?serverVersion=16&charset=utf8

DEFAULT_URI=https://api.clapiers.local
APP_FRONTEND_URL=https://app.clapiers.local

# Mailer — null://null disables sending. Real DSN in .env.local / k8s.
MAILER_DSN=null://null
CONTACT_RECIPIENT_EMAIL=info@clapiersvb.fr
CONTACT_SENDER_EMAIL=info@clapiersvb.fr

# Google reCAPTCHA v2 secret — empty disables verification. Real key elsewhere.
RECAPTCHA_SECRET_KEY=

# Bunny Storage (pièces de la médiathèque) : PAS de variable d'environnement,
# la zone et sa clé se règlent dans l'administration (Paramètres → Stockage des
# fichiers), comme HelloAsso. Voir docs/members-and-mediatheque.md.
