# ============================================================================
# Backend (Symfony) environment — template.
# ----------------------------------------------------------------------------
# Copy to `backend/.env` and fill in real values. `backend/.env` is gitignored.
# In Docker these are injected into the php container via `env_file`.
# ============================================================================

APP_ENV=dev
APP_SECRET=change_me

# In Docker the DB host is the `postgres` service. Outside Docker (native run),
# override DATABASE_URL in backend/.env.local or via a real env var.
DATABASE_URL=postgresql://symfony:symfony@postgres:5432/clapiers_db?serverVersion=16&charset=utf8

DEFAULT_URI=https://api.clapiers.local
APP_FRONTEND_URL=https://app.clapiers.local

# --- Mailer (Brevo transactional) ---
# brevo+api://YOUR_BREVO_API_KEY@default to send; null://null to disable.
MAILER_DSN=null://null
CONTACT_RECIPIENT_EMAIL=info@clapiersvb.fr
CONTACT_SENDER_EMAIL=info@clapiersvb.fr

# --- Google reCAPTCHA v2 (checkbox) secret — leave empty to disable ---
RECAPTCHA_SECRET_KEY=

# --- HelloAsso (paiement des licences) ---
# FORM_TYPE = "Membership" (adhésion) ou "Event" (billetterie).
HELLOASSO_BASE_URL=https://api.helloasso-sandbox.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORGANIZATION_SLUG=
HELLOASSO_MEMBERSHIP_FORM_TYPE=Membership
HELLOASSO_MEMBERSHIP_FORM_SLUG=

# --- Xdebug (off by default; set to "debug" + reload to enable) ---
XDEBUG_MODE=off
XDEBUG_CONFIG=client_host=host.docker.internal
