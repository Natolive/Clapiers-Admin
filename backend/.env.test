# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Defaults so the kernel boots outside docker-compose (e.g. in CI).
# Real environment variables (docker) and phpunit.dist.xml overrides win.
# DATABASE_URL now comes from the committed backend/.env (points at the
# `postgres` service); CI exports its own (127.0.0.1), which wins.
DEFAULT_URI=http://localhost
MAILER_DSN=null://null
RECAPTCHA_SECRET_KEY=
CONTACT_RECIPIENT_EMAIL=test@clapiersvb.fr
CONTACT_SENDER_EMAIL=test@clapiersvb.fr

APP_FRONTEND_URL=http://localhost:3000
